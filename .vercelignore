# Files that must never be uploaded by `vercel deploy`.
# (The CLI uploads from disk, not from git, so .gitignore doesn't protect us here.)

# Secret-scanning hooks and their tooling
.githooks/
.gitleaks.toml
scripts/install-gitleaks.sh
scripts/test-hooks.sh
.github/

# Local credential files. Vercel gets its secrets from `vercel env`, never from files.
.env*
!.env.example

# Course notes
INSTRUCTIONS.md

# Build output and dependencies; Vercel installs and builds remotely
node_modules/
.next/

# Private puzzle content for the seed script (#52). Git-ignored, but deploys upload from disk.
content/

# Claude Code workspace: agent worktrees (full repo copies with node_modules) and settings. Local only.
.claude/
