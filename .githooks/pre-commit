#!/usr/bin/env bash
# Block commits that contain secrets. Scans only the staged changes.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the commit is blocked." >&2
  echo "            Install it with: scripts/install-gitleaks.sh" >&2
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose \
     --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"; then
  echo >&2
  echo "pre-commit: possible secret found (above, redacted). Commit blocked." >&2
  echo "            Move real values into .env.local, which git ignores." >&2
  exit 1
fi
