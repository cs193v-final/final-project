#!/usr/bin/env bash
# Block pushes that contain secrets. Scans EVERY commit being pushed,
# not just the latest one.
set -euo pipefail
# shellcheck source=.githooks/_common.sh
. "$(dirname "$0")/_common.sh"

require_gitleaks pre-push

status=0

# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha remote_ref remote_sha; do
  is_zero_sha "$local_sha" && continue            # deleting a branch: nothing to scan
  if is_zero_sha "$remote_sha"; then
    range="$local_sha --not --remotes"            # new branch: commits not yet on any remote
  elif ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # e.g. force-pushing after a rebase without fetching first
    echo "pre-push: the remote's tip of $remote_ref ($remote_sha) isn't in your clone." >&2
    echo "          Run 'git fetch' and push again." >&2
    status=1
    continue
  else
    range="$remote_sha..$local_sha"               # existing branch: only the new commits
  fi

  rc=0
  gitleaks git --redact --no-banner --verbose --exit-code "$GITLEAKS_LEAK_EXIT" \
    --config "$config" --log-opts="$range" || rc=$?

  if [ "$rc" -eq "$GITLEAKS_LEAK_EXIT" ]; then
    echo >&2
    echo "pre-push: possible secret in commits for $remote_ref (above, redacted). Push blocked." >&2
    echo "          Remove it from history (e.g. git reset / amend) before pushing." >&2
    status=1
  elif [ "$rc" -ne 0 ]; then
    echo >&2
    echo "pre-push: gitleaks failed to run for $remote_ref (exit $rc, error above). Push blocked." >&2
    echo "          This is a tool error, not a detected secret." >&2
    status=1
  fi
done

exit $status
