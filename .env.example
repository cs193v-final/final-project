# Copy this file to .env.local and fill in the values from the
# final-project-dev Neon project ("Copy .env" in the Neon console).
# Preview and production values live ONLY in Vercel (vercel env add ... --sensitive).
#
# Names follow Neon's convention:
#   DATABASE_URL           pooled (host has "-pooler"); use for app queries
#   DATABASE_URL_UNPOOLED  direct; use for migrations and session features
#                          (prepared statements, advisory locks, SET)
DATABASE_URL=postgresql://USER:PASSWORD@host-pooler/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@host/neondb?sslmode=require&channel_binding=require
